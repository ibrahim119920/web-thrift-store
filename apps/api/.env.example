PORT=5000
MONGODB_URI=mongodb://localhost:27017/wanttosell?replicaSet=rs0&directConnection=true
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak
JWT_EXPIRES_IN=7d
# --- Midtrans (pembayaran asli, Snap) -------------------------------------
# Ambil dari Midtrans Dashboard > Settings > Access Keys.
# Sandbox: SB-Mid-server-xxxx / Production: Mid-server-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-ganti-dengan-server-key
# Client key hanya dibutuhkan jika memakai popup Snap.js di frontend (mode redirect tidak perlu).
MIDTRANS_CLIENT_KEY=SB-Mid-client-ganti-dengan-client-key
# false = sandbox (app.sandbox.midtrans.com), true = produksi (app.midtrans.com)
MIDTRANS_IS_PRODUCTION=false
# URL frontend, dipakai untuk callbacks.finish setelah pembayaran selesai.
FRONTEND_URL=http://localhost:5173
# Daftarkan URL ini juga di Midtrans Dashboard > Settings > Payment > Notification URL
# (harus publik & HTTPS, mis. https://api.domainanda.com/api/payments/webhook)
MIDTRANS_NOTIFICATION_URL=http://localhost:5000/api/payments/webhook
# Set false di production agar endpoint simulasi (/payments/qris, /payments/bank-transfer) mati.
PAYMENT_SIMULATION=true

# [Lama] key simulasi webhook. Hanya dipakai endpoint simulasi & koleksi Postman.
PAYMENT_SERVER_KEY=SB-Mid-server-contoh-ganti-ini
# Batas waktu bayar setelah checkout (menit)
ORDER_EXPIRY_MINUTES=60
# Email (Zoho ZeptoMail). Token: ZeptoMail > Mail Agents > SMTP/API > Send Mail Token.
# Host sesuai data center akun: api.zeptomail.com (US), api.zeptomail.in, api.zeptomail.eu, api.zeptomail.com.au, dst.
ZEPTOMAIL_API_HOST=api.zeptomail.com
ZEPTOMAIL_TOKEN=Zoho-enczapikey ganti-dengan-token-anda
# Alamat pengirim harus memakai domain yang sudah diverifikasi di ZeptoMail
EMAIL_FROM_ADDRESS=noreply@domainanda.com
EMAIL_FROM_NAME=WantToSell
# Email otomatis (konfirmasi order, pembayaran, pengiriman). Nonaktif jika token belum diisi, atau set false.
EMAIL_NOTIFICATIONS=true
